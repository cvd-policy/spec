{
  "name": "cvd-policy-spec",
  "version": "0.2.0",
  "private": true,
  "description": "CVD Policy Format — specification, JSON Schema, examples and test corpus.",
  "license": "CC0-1.0",
  "type": "module",
  "scripts": {
    "build-corpus": "node scripts/build-corpus.mjs",
    "build:v1": "node scripts/build-v1-corpus.mjs && node scripts/build-v1-requirements.mjs",
    "test": "node scripts/validate-corpus.mjs",
    "test:v1": "node scripts/validate-v1-corpus.mjs && node scripts/check-v1-requirements.mjs",
    "check": "npm test && npm run test:v1",
    "build-schema": "node scripts/build-schema.mjs",
    "build": "node scripts/build-schema.mjs && node scripts/build-corpus.mjs"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  }
}
